# Local development placeholders only. Do not commit real credentials.
# Export these variables through your local launcher; Spring does not load this file itself.
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/moviemux_local
DB_USER=your_local_db_user
DB_PASS=replace_with_local_db_password
DB_SCHEMA=public

JWT_SECRET=replace_with_at_least_32_random_bytes_for_local_use

CINE_SEND_MAIL=false
MOVIEMUX_MAIL_URL=http://localhost:3000

DISCORD_WEBHOOK_EXECUTE=false
DISCORD_WEBHOOK_UPDATE=false
DISCORD_WEBHOOK_URL=http://localhost:3001/discord/webhook
DISCORD_WEBHOOK_ROLE_ID=replace_with_role_id

KIT_URL=http://localhost:3002
KIT_KEY=replace_with_local_kit_api_key

SOCKET_IO_API_URL=http://localhost:3333
SOCKET_IO_API_KEY=replace_with_local_socket_api_key
